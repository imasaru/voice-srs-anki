<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only. adb sends an explicit component broadcast from the shell uid,
         which holds android.permission.DUMP; third-party apps cannot obtain DUMP
         (signature|privileged|development), so it locks the receivers down while
         keeping the adb harness working. Release has no receiver. -->
    <application>
        <provider
            android:name=".ScriptedSpeechProvider"
            android:authorities="com.evan.voicesrs.scripted"
            android:exported="false" />
        <receiver
            android:name=".TestGradeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.evan.voicesrs.TEST_GRADE" />
                <action android:name="com.evan.voicesrs.TEST_SHOW_ANSWER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".TestScriptReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.evan.voicesrs.TEST_SCRIPT" />
                <action android:name="com.evan.voicesrs.TEST_UTTER" />
                <action android:name="com.evan.voicesrs.TEST_RECOGNIZER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
