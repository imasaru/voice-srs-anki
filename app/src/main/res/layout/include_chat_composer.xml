<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatComposer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/chatAskAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:textColor="@color/chat_meta"
        android:textSize="11sp"
        android:visibility="gone" />

    <com.google.android.material.chip.Chip
        android:id="@+id/todayReportChip"
        style="@style/Widget.Material3.Chip.Suggestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/today_report"
        android:visibility="gone"
        app:checkedIconVisible="false" />

    <TextView
        android:id="@+id/chatDictateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/chat_dictate_miss"
        android:textColor="@color/chat_meta"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/chatInputShell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:minHeight="48dp">

            <EditText
                android:id="@+id/chatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/chat_ask_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="44dp"
                android:paddingBottom="10dp"
                android:textColor="@color/chat_input_text"
                android:textColorHint="@color/chat_input_hint"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/chatDictate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_dictate_cd"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic"
                app:tint="@color/chat_accent" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/chatSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_send"
            android:contentDescription="@string/chat_send_cd"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_send"
            app:tint="@color/chat_send_icon" />
    </LinearLayout>
</LinearLayout>
