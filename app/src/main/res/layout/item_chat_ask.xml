<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/askQuestionBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_bubble_user"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/askQuestionCorner"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_marginEnd="-6dp"
            android:layout_marginBottom="-22dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/askQuestionPlayIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/corner_read_aloud"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume_up"
                app:tint="#99FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/askQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/bubble_user_on" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/askReplyBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_bubble_ai"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/askReplyCorner"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_marginEnd="-6dp"
            android:layout_marginBottom="-22dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/askReplyPlayIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/corner_read_aloud"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume_up"
                app:tint="#99FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/askReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/bubble_ai_on"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
