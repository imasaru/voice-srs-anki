<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- Left, muted: first line of the question. Tap expands the full stem. -->
    <TextView
        android:id="@+id/cardBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_bubble_card"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Right, accent: recognised answer · rating. -->
    <TextView
        android:id="@+id/userBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_bubble_user"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnPrimary" />

    <!-- Left, distinct colour: explanation only. Never the prompt. -->
    <LinearLayout
        android:id="@+id/aiBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_bubble_ai"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/explSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/explBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/expl_badge_cd"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="@string/expl_badge"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:visibility="gone" />

            <TextView
                android:id="@+id/explStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnTertiaryContainer" />

            <TextView
                android:id="@+id/explBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:visibility="gone" />

            <Button
                android:id="@+id/explRetry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/expl_retry"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
