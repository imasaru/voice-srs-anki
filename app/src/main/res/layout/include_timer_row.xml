<?xml version="1.0" encoding="utf-8"?>
<!-- h94c: TimerWrapRow: line1 = icon, elapsed, - value +; label+switch on line1 right if they fit the row width, else wrapped right-aligned on line 2. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timerRow"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:contentDescription="@string/timer_title"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:contentPadding="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <com.evan.voicesrs.TimerWrapRow
        android:id="@+id/timerLines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/timerLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/timerIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/timer_title"
                android:src="@drawable/ic_timer" />

            <TextView
                android:id="@+id/elapsedChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <Button
                android:id="@+id/timerMinus"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:insetLeft="@dimen/timer_stepper_inset"
                android:insetTop="@dimen/timer_stepper_inset"
                android:insetRight="@dimen/timer_stepper_inset"
                android:insetBottom="@dimen/timer_stepper_inset"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="@string/timer_fewer"
                android:text="−"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/timer_stepper_stroke" />

            <TextView
                android:id="@+id/timerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/timer_value_margin"
                android:layout_marginEnd="@dimen/timer_value_margin"
                android:minWidth="@dimen/timer_value_min_width"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="16sp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:text="10 min" />

            <Button
                android:id="@+id/timerPlus"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetLeft="@dimen/timer_stepper_inset"
                android:insetTop="@dimen/timer_stepper_inset"
                android:insetRight="@dimen/timer_stepper_inset"
                android:insetBottom="@dimen/timer_stepper_inset"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="@string/timer_more"
                android:text="+"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/timer_stepper_stroke" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timerLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timerSwitchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:gravity="end|center_vertical"
                android:labelFor="@+id/timerSwitch"
                android:maxLines="1"
                android:text="@string/timer_switch_text"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/timerSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:contentDescription="@string/timer_switch_label" />
        </LinearLayout>
    </com.evan.voicesrs.TimerWrapRow>
</com.google.android.material.card.MaterialCardView>
