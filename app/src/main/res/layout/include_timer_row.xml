<!-- h122: two fixed rows, see h122/reference/mockup-spec.md -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/timerRow"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:contentPadding="12dp">

    <com.evan.voicesrs.TimerWrapRow
        android:id="@+id/timerLines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/timerLine1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/elapsedChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="0:00"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/elapsedCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_elapsed_caption"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timerGoalChip"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:checkable="true"
                    android:contentDescription="@string/timer_switch_label"
                    app:icon="@drawable/ic_drill_stop"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_goal_short"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/voiceChip"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:checkable="true"
                    android:contentDescription="@string/voice_chip"
                    app:icon="@drawable/ic_mic"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_short"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timerLine2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timerMinus"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:insetLeft="@dimen/timer_stepper_inset"
                android:insetTop="@dimen/timer_stepper_inset"
                android:insetRight="@dimen/timer_stepper_inset"
                android:insetBottom="@dimen/timer_stepper_inset"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="@string/timer_fewer"
                android:text="−"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/timer_stepper_stroke" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/timerGoalBar"
                    android:max="1000"
                    android:indeterminate="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    app:indicatorColor="?attr/colorTertiary"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="10dp"
                    app:trackThickness="20dp" />

                <TextView
                    android:id="@+id/timerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="10 min"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timerPlus"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetLeft="@dimen/timer_stepper_inset"
                android:insetTop="@dimen/timer_stepper_inset"
                android:insetRight="@dimen/timer_stepper_inset"
                android:insetBottom="@dimen/timer_stepper_inset"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="@string/timer_more"
                android:text="+"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/timer_stepper_stroke" />
        </LinearLayout>
    </com.evan.voicesrs.TimerWrapRow>
</com.google.android.material.card.MaterialCardView>
